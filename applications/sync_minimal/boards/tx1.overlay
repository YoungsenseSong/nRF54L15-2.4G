/ {
	chosen {
		zephyr,console = &uart00;
		zephyr,shell-uart = &uart00;
	};
};

&pinctrl {
	uart00_sync_default: uart00_sync_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 2)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 2, 0)>;
			bias-pull-up;
		};
	};

	uart00_sync_sleep: uart00_sync_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 2)>,
				<NRF_PSEL(UART_RX, 2, 0)>;
			low-power-enable;
		};
	};
};

&uart00 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart00_sync_default>;
	pinctrl-1 = <&uart00_sync_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ hw-flow-control;
};

&uart30 {
	status = "disabled";
};
