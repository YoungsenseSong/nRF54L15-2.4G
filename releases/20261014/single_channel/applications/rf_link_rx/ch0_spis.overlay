#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	ch0_fpga_if: ch0-fpga-interface {
		compatible = "makerdiary,rf-link-ch0-interface";
		drdy-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		sync-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	ch0_spis00_default: ch0_spis00_default {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 2, 1)>,
				<NRF_PSEL(SPIS_MOSI, 2, 4)>,
				<NRF_PSEL(SPIS_MISO, 2, 2)>,
				<NRF_PSEL(SPIS_CSN, 2, 5)>;
		};
	};

	ch0_spis00_sleep: ch0_spis00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 2, 1)>,
				<NRF_PSEL(SPIS_MOSI, 2, 4)>,
				<NRF_PSEL(SPIS_MISO, 2, 2)>,
				<NRF_PSEL(SPIS_CSN, 2, 5)>;
			low-power-enable;
		};
	};
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpiote20 {
	status = "okay";
};

&spi00 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	def-char = <0x00>;
	overrun-character = <0x00>;
	pinctrl-0 = <&ch0_spis00_default>;
	pinctrl-1 = <&ch0_spis00_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ rx-delay-supported;
	/delete-property/ rx-delay;
};
